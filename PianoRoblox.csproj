<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PianoRoblox</AssemblyName>
    <Version>2.0.0</Version>
    <Product>PianoRoblox</Product>
    <Description>MIDI &amp; Sheet Player for Roblox Piano</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Core\**;Tests\**" />
    <EmbeddedResource Remove="Core\**;Tests\**" />
    <None Remove="Core\**;Tests\**" />
    <ProjectReference Include="Core\PianoRoblox.Core.csproj" />
  </ItemGroup>
</Project>


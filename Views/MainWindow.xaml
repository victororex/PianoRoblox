<Window x:Class="PianoRoblox.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PianoRoblox.Views"
 Title="PianoRoblox" Style="{StaticResource {x:Type Window}}" Width="1180" Height="920" MinWidth="850" MinHeight="650" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="28,20">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="PianoRoblox" FontSize="23" FontWeight="Bold"/><TextBlock Text="MIDI &amp; Sheet Player for Roblox Piano" Style="{StaticResource Muted}"/></StackPanel>
   <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="16,10" VerticalAlignment="Center"><TextBlock Text="{Binding PlayerState}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></Border>
  </Grid>
  <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="14,10" Margin="0,12,0,0"><StackPanel>
   <DockPanel><StackPanel DockPanel.Dock="Left" Width="210" Margin="0,0,16,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel>
    <WrapPanel><Button Content="⏮" ToolTip="Anterior / reiniciar (F4)" Command="{Binding PreviousCommand}"/><Button Content="▶ / Ⅱ" ToolTip="Tocar / pausar" Command="{Binding PlayPauseCommand}" Style="{StaticResource Primary}"/><Button Content="■" ToolTip="Parar (F8)" Command="{Binding StopCommand}"/><Button Content="⏭" ToolTip="Próxima (F5)" Command="{Binding NextCommand}"/><CheckBox Content="Shuffle" IsChecked="{Binding Library.Shuffle}" VerticalAlignment="Center"/><Button Content="{Binding Library.RepeatLabel}" Command="{Binding Library.CycleRepeatCommand}"/></WrapPanel>
   </DockPanel>
   <DockPanel Margin="0,4,0,8"><TextBlock Text="{Binding CurrentTime}" DockPanel.Dock="Left" Margin="0,0,10,0"/><TextBlock Text="{Binding TotalTime}" DockPanel.Dock="Right" Margin="10,0,0,0"/><ProgressBar Height="5" Maximum="{Binding DurationMaximum}" Value="{Binding PositionMs, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/></DockPanel>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="F4 anterior · F5 próxima · F6 iniciar · F7 pausar · F8 parar · F9 +5% · F10 −5% · F11 100%" Style="{StaticResource Muted}" FontSize="11"/>
  </StackPanel></Border>
  <TabControl SelectedIndex="{Binding SelectedTab}">
   <TabItem Header="Player"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,8,0">
    <WrapPanel><Button Content="Importar MIDI" Command="{Binding ImportMidiCommand}" Style="{StaticResource Primary}"/><Button Content="Colar Sheet" Command="{Binding PasteCommand}"/><Button Content="Importar JSON" Command="{Binding ImportJsonCommand}"/><Button Content="Exportar sequência" Command="{Binding ExportJsonCommand}"/></WrapPanel>
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="20" Margin="0,8,0,16"><StackPanel>
     <TextBlock Text="MÚSICA" Style="{StaticResource Muted}" FontSize="11"/><TextBox Text="{Binding Title}" FontSize="23" FontWeight="SemiBold" BorderThickness="0" Background="Transparent"/>
     <TextBlock Text="{Binding Statistics}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
     <TextBlock Text="{Binding RangeStatus}" Margin="0,8,0,12" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"/>
     <WrapPanel>
      <StackPanel Width="170"><TextBlock Text="Transposição (semitons)" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding TransposeOptions}" Text="{Binding Transpose}" IsEditable="True"/><Slider Minimum="-24" Maximum="24" Value="{Binding Transpose}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,12,0"/></StackPanel>
      <StackPanel Width="250"><TextBlock Text="Velocidade (%)" Style="{StaticResource Muted}"/><DockPanel><TextBox DockPanel.Dock="Right" Width="70" Text="{Binding Speed, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/><Slider Minimum="50" Maximum="150" Value="{Binding Speed}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,12,8"/></DockPanel><TextBlock Text="{Binding RealDuration}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
      <StackPanel Width="150"><TextBlock Text="Chord spread (ms)" Style="{StaticResource Muted}"/><TextBox Text="{Binding Settings.ChordSpreadMs, ValidatesOnExceptions=True}"/></StackPanel>
      <StackPanel Width="150"><TextBlock Text="Contagem (s)" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding CountdownOptions}" SelectedItem="{Binding Settings.CountdownSeconds}"/></StackPanel>
     </WrapPanel>
     <WrapPanel Margin="0,18,0,0"><Button Content="▶  Play" Command="{Binding PlayCommand}" Style="{StaticResource Primary}" MinWidth="110"/><Button Content="Ⅱ  Pause / Resume" Command="{Binding PauseCommand}"/><Button Content="■  Stop" Command="{Binding StopCommand}"/><Button Content="↺  Restart" Command="{Binding RestartCommand}"/></WrapPanel>
     <DockPanel Margin="0,6,0,6"><TextBlock Text="{Binding CurrentTime}" DockPanel.Dock="Left" Margin="0,0,12,0"/><TextBlock Text="{Binding TotalTime}" DockPanel.Dock="Right" Margin="12,0,0,0"/><ProgressBar Height="7" Maximum="{Binding DurationMaximum}" Value="{Binding PositionMs, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource FieldBrush}"/></DockPanel>
     <DockPanel Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="Iniciar daqui" Command="{Binding SeekCommand}"/><TextBlock DockPanel.Dock="Right" Text="{Binding SeekTime}" Margin="12,0,12,8"/><Slider Minimum="0" Maximum="{Binding DurationMaximum}" Value="{Binding SeekMs}" VerticalAlignment="Center" Margin="0,0,0,8"/></DockPanel>
    </StackPanel></Border>
    <StackPanel Visibility="{Binding Settings.ShowKeyboard, Converter={StaticResource BoolVisibility}}"><TextBlock Text="PIANO  ·  C2–C7" Style="{StaticResource Muted}"/><local:PianoKeyboard ActiveNotes="{Binding ActiveNotes}" Margin="0,0,0,16"/></StackPanel>
    <TextBlock Text="TIMELINE  ·  5 anteriores + evento atual + 10 próximos" Style="{StaticResource Muted}"/>
    <DataGrid ItemsSource="{Binding Timeline}" Height="220"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding Current}" Value="True"><Setter Property="Background" Value="#216D5D"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50"/><DataGridTextColumn Header="Tempo" Binding="{Binding Time}" Width="120"/><DataGridTextColumn Header="Teclas" Binding="{Binding Keys}" Width="*"/><DataGridTextColumn Header="Notas" Binding="{Binding Notes}" Width="2*"/></DataGrid.Columns></DataGrid>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Sheet"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,8,0">
    <TextBlock Text="Uma sheet, seu jeito de tocar" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="Esta sheet não contém timing preciso. O ritmo será estimado." Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,16"/>
    <WrapPanel><StackPanel Width="130"><TextBlock Text="BPM (20–400)" Style="{StaticResource Muted}"/><TextBox Text="{Binding SheetBpm, ValidatesOnExceptions=True}"/></StackPanel><StackPanel Width="220"><TextBlock Text="Espaço (em beats)" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding SpaceOptions}" SelectedItem="{Binding SpaceBeats}"/></StackPanel><StackPanel Width="220"><TextBlock Text="Cada hífen (em beats)" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding DashOptions}" SelectedItem="{Binding DashBeats}"/></StackPanel></WrapPanel>
    <TextBlock Text="0,0625 = 1/16  ·  0,125 = 1/8  ·  0,25 = 1/4  ·  0,5 = 1/2  ·  1 = 1 beat" Style="{StaticResource Muted}"/>
    <TextBox Text="{Binding SheetText, UpdateSourceTrigger=PropertyChanged}" Height="280" AcceptsReturn="True" AcceptsTab="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="19"/>
    <WrapPanel><Button Content="Colar" Command="{Binding PasteCommand}"/><Button Content="Limpar" Command="{Binding ClearCommand}"/><Button Content="Analisar Sheet" Command="{Binding AnalyzeCommand}"/><Button Content="Tocar Sheet" Command="{Binding PlaySheetCommand}" Style="{StaticResource Primary}"/></WrapPanel>
    <TextBlock Text="{Binding SheetStatistics}" TextWrapping="Wrap" Margin="0,10"/>
    <TextBlock Text="a = nota  ·  [abc] = acorde  ·  {abcd} = sequência rápida (1/16 beat por nota)&#10;- = pausa  ·  -- = duas pausas  ·  Espaços e quebras de linha somam tempo.&#10;Maiúsculas exigem Shift. Caracteres desconhecidos precisam ser corrigidos antes de tocar." TextWrapping="Wrap" Style="{StaticResource Muted}"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Biblioteca"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="0,16,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="195"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel DataContext="{Binding Library}" Margin="0,0,16,0">
     <TextBlock Text="BIBLIOTECA" Style="{StaticResource Muted}"/><Button Content="Todas as músicas" Command="{Binding ShowAllCommand}"/>
     <TextBlock Text="PLAYLISTS" Style="{StaticResource Muted}" Margin="0,12,0,8"/>
     <ListBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}" DisplayMemberPath="Name" Height="180" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}"/>
     <TextBlock Text="Nome da playlist" Style="{StaticResource Muted}" Margin="0,12,0,4"/><TextBox Text="{Binding PlaylistName, UpdateSourceTrigger=PropertyChanged}"/>
     <Button Content="+ Nova playlist" Command="{Binding CreatePlaylistCommand}"/><Button Content="Renomear" Command="{Binding RenamePlaylistCommand}"/><Button Content="Excluir playlist" Command="{Binding DeletePlaylistCommand}"/>
    </StackPanel>
    <StackPanel Grid.Column="1">
     <TextBlock Text="{Binding Library.CollectionTitle}" FontSize="22" FontWeight="SemiBold"/>
     <TextBlock Text="Duplo clique para tocar. Cada música guarda seus ajustes de otimização." TextWrapping="Wrap" Style="{StaticResource Muted}"/>
     <DataGrid ItemsSource="{Binding Library.VisibleSongs}" SelectedItem="{Binding Library.SelectedSong}" SelectionMode="Single" Height="220" Margin="0,12" MouseDoubleClick="SongDoubleClicked"><DataGrid.Columns><DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="*"/><DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="65"/><DataGridTextColumn Header="BPM" Binding="{Binding Bpm, StringFormat=F1}" Width="65"/></DataGrid.Columns></DataGrid>
     <WrapPanel><Button Content="Tocar" Command="{Binding Library.PlaySelectedCommand}" Style="{StaticResource Primary}"/><Button Content="Carregar" Command="{Binding Library.LoadSelectedCommand}"/><Button Content="+ Fila" Command="{Binding Library.AddToQueueCommand}"/><Button Content="↑" ToolTip="Subir na playlist" Command="{Binding Library.MoveSongUpCommand}"/><Button Content="↓" ToolTip="Descer na playlist" Command="{Binding Library.MoveSongDownCommand}"/><Button Content="Tirar da playlist" Command="{Binding Library.RemoveFromPlaylistCommand}"/><Button Content="Remover da biblioteca" Command="{Binding DeleteSongCommand}"/></WrapPanel>
     <WrapPanel><ComboBox Width="200" ItemsSource="{Binding Library.Playlists}" SelectedItem="{Binding Library.TargetPlaylist}" DisplayMemberPath="Name"/><Button Content="Adicionar à playlist" Command="{Binding Library.AddToPlaylistCommand}"/></WrapPanel>
     <Expander Header="Salvar música carregada / atualizar ajustes" Margin="0,10" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="0,10,0,0">
      <WrapPanel><StackPanel Width="220"><TextBlock Text="Título" Style="{StaticResource Muted}"/><TextBox Text="{Binding Title}"/></StackPanel><StackPanel Width="200"><TextBlock Text="Artista" Style="{StaticResource Muted}"/><TextBox Text="{Binding Artist}"/></StackPanel><StackPanel Width="220"><TextBlock Text="Origem" Style="{StaticResource Muted}"/><TextBox Text="{Binding Origin}"/></StackPanel></WrapPanel>
      <WrapPanel><Button Content="Adicionar como nova música" Command="{Binding SaveSongCommand}"/><Button Content="Salvar ajustes da carregada" Command="{Binding UpdateSongCommand}"/></WrapPanel>
     </StackPanel></Expander>
     <TextBlock Text="TOCANDO AGORA / CONTEXTO" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Library.CurrentTitle}" FontWeight="SemiBold" Margin="0,6,0,12"/>
     <TextBlock Text="PRÓXIMAS" Style="{StaticResource Muted}"/>
     <ListBox ItemsSource="{Binding Library.Upcoming}" SelectedItem="{Binding Library.SelectedQueueItem}" DisplayMemberPath="Title" Height="120" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" Margin="0,8"/>
     <WrapPanel><Button Content="Remover da fila" Command="{Binding Library.RemoveFromQueueCommand}"/><Button Content="Limpar próximas" Command="{Binding Library.ClearQueueCommand}"/></WrapPanel>
    </StackPanel>
   </Grid></ScrollViewer></TabItem>
   <TabItem Header="Teste"><StackPanel Margin="0,20,0,0"><TextBlock Text="Conheça cada tecla" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Clique em uma tecla e volte ao Roblox durante a contagem regressiva. F8 interrompe o teste." TextWrapping="Wrap" Style="{StaticResource Muted}"/>
    <local:PianoKeyboard ActiveNotes="{Binding ActiveNotes}" IsInteractive="True" NoteClicked="PianoNoteClicked" Margin="0,16"/>
    <WrapPanel><Button Content="Testar escala C4–C5" Command="{Binding ScaleCommand}"/><Button Content="Testar acorde C4 E4 G4" Command="{Binding ChordCommand}"/><Button Content="Carregar teste de 3 acordes" Command="{Binding DemoCommand}"/></WrapPanel>
    <TextBlock Text="Cada tecla exibe nota, MIDI e caractere exato. Teclas pretas exigem Shift.&#10;O teste de três acordes carrega: 0 ms → t u o; 1000 ms → y i p; 2000 ms → u o a.&#10;Depois de carregar, use Play na aba Player." TextWrapping="Wrap" Style="{StaticResource Muted}"/>
   </StackPanel></TabItem>
   <TabItem Header="Configurações"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,0,0" MaxWidth="780" HorizontalAlignment="Left">
    <TextBlock Text="Ajuste ao seu piano" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding ProfileName}" Style="{StaticResource Muted}" Margin="0,8"/>
    <WrapPanel><StackPanel Width="230"><TextBlock Text="Playback Performance Mode" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding PerformanceModes}" SelectedItem="{Binding Settings.PerformanceMode}"/></StackPanel><StackPanel Width="230"><TextBlock Text="Contagem entre músicas (s)" Style="{StaticResource Muted}"/><TextBox Text="{Binding Settings.CountdownBetweenSongs, ValidatesOnExceptions=True}"/></StackPanel></WrapPanel>
    <TextBlock Text="Normal: padrão · LowLatency: espera mais curta · FpsFriendly: limita rajadas de envio. Nenhum modo altera o BPM." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
    <WrapPanel Margin="0,14,0,0"><StackPanel Width="230"><TextBlock Text="Chord spread: 0–50 ms" Style="{StaticResource Muted}"/><TextBox Text="{Binding Settings.ChordSpreadMs, ValidatesOnExceptions=True}"/></StackPanel><StackPanel Width="230"><TextBlock Text="Key hold: 1–100 ms" Style="{StaticResource Muted}"/><TextBox Text="{Binding Settings.KeyHoldMs, ValidatesOnExceptions=True}"/></StackPanel><StackPanel Width="230"><TextBlock Text="Contagem: 0–10 s" Style="{StaticResource Muted}"/><TextBox Text="{Binding Settings.CountdownSeconds, ValidatesOnExceptions=True}"/></StackPanel></WrapPanel>
    <WrapPanel><StackPanel Width="230"><TextBlock Text="Modo de acordes" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding ChordModes}" SelectedItem="{Binding Settings.ChordMode}"/></StackPanel><StackPanel Width="230"><TextBlock Text="Modo SendInput" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding InputModes}" SelectedItem="{Binding Settings.InputMode}"/></StackPanel><StackPanel Width="230"><TextBlock Text="Velocidade padrão: 50–150%" Style="{StaticResource Muted}"/><TextBox Text="{Binding Settings.DefaultSpeed, ValidatesOnExceptions=True}"/></StackPanel></WrapPanel>
    <TextBlock Text="Notas fora do alcance" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding RangePolicies}" SelectedItem="{Binding Settings.RangePolicy}" Width="220" HorizontalAlignment="Left"/>
    <TextBlock Text="Ignore: ignorar  ·  Octave: transpor por oitava  ·  Ask: perguntar antes de tocar.&#10;Auto: simultâneo sem Shift; sequência protegida com Shift.&#10;Spread: todas as notas em sequência. Simultaneous: simultâneo quando não há Shift." TextWrapping="Wrap" Style="{StaticResource Muted}"/>
    <CheckBox Content="Somente tocar se Roblox estiver em foco" IsChecked="{Binding Settings.RequireRobloxFocus}"/>
    <CheckBox Content="Mostrar teclado virtual no Player" IsChecked="{Binding Settings.ShowKeyboard}"/>
    <CheckBox Content="Tema escuro" IsChecked="{Binding Settings.DarkTheme}"/>
    <CheckBox Content="Log detalhado (eventos musicais)" IsChecked="{Binding Settings.DetailedLog}"/>
    <Button Content="Salvar configurações" Command="{Binding SaveSettingsCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,14,0,8"/>
    <TextBlock Text="Mudanças de envio, acordes e alcance valem no próximo Play. Velocidade muda durante a reprodução.&#10;O tempo efetivo entre notas sequenciais nunca é menor que Key Hold + preparação de Shift.&#10;A compatibilidade com o jogo precisa ser verificada na aba Teste. Não há detecção automática de notas recebidas.&#10;Atalhos podem ser alterados em settings.json com o app fechado (códigos virtuais do Windows)." TextWrapping="Wrap" Style="{StaticResource Muted}"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Log"><ListBox ItemsSource="{Binding Logs}" Margin="0,20,0,0" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></TabItem>
   <TabItem Header="MIDI • Smart Optimize"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,8,0">
    <WrapPanel><Button Content="Importar MIDI" Command="{Binding ImportMidiCommand}" Style="{StaticResource Primary}"/><Button Content="Exportar sequência otimizada" Command="{Binding ExportJsonCommand}"/><Button Content="Salvar ajustes da música" Command="{Binding UpdateSongCommand}"/></WrapPanel>
    <StackPanel DataContext="{Binding MidiImport}">
     <TextBlock Text="{Binding MetadataSummary}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10"/>
     <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
     <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,8"/>
     <WrapPanel Margin="0,12,0,0"><StackPanel Width="210"><TextBlock Text="Smart Optimize" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}"/></StackPanel><CheckBox Content="Ignorar bateria/percussão" IsChecked="{Binding RemovePercussion}" VerticalAlignment="Center"/><CheckBox Content="Melody Priority" IsChecked="{Binding MelodyPriority}" VerticalAlignment="Center"/></WrapPanel>
     <WrapPanel IsEnabled="{Binding IsCustom}"><StackPanel Width="145"><TextBlock Text="Merge (ms)" Style="{StaticResource Muted}"/><TextBox Text="{Binding MergeWindowMs, ValidatesOnExceptions=True}"/></StackPanel><StackPanel Width="145"><TextBlock Text="Máximo por acorde" Style="{StaticResource Muted}"/><TextBox Text="{Binding MaxChordNotes, ValidatesOnExceptions=True}"/></StackPanel><StackPanel Width="145"><TextBlock Text="Velocity mínima" Style="{StaticResource Muted}"/><TextBox Text="{Binding MinimumVelocity, ValidatesOnExceptions=True}"/></StackPanel><StackPanel Width="145"><TextBlock Text="Notas / 250 ms" Style="{StaticResource Muted}"/><TextBox Text="{Binding MaxNotesPer250Ms, ValidatesOnExceptions=True}"/></StackPanel><StackPanel Width="145"><TextBlock Text="Notas / segundo" Style="{StaticResource Muted}"/><TextBox Text="{Binding MaxNotesPerSecond, ValidatesOnExceptions=True}"/></StackPanel></WrapPanel>
     <TextBlock Text="Os campos acima valem em Custom. Original preserva notas; Balanced usa 6 ms / 6 / 15 / 10 / 32; Performance usa 8 ms / 4 / 25 / 7 / 22." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding RecommendationSummary}" TextWrapping="Wrap" Margin="0,10"/><TextBlock Text="{Binding PercussionSummary}" Foreground="{DynamicResource AccentBrush}"/>
     <Grid Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="ANTES • MIDI COMPLETO" Style="{StaticResource Muted}"/><TextBlock Text="{Binding BeforeSummary}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="DEPOIS • TRILHAS SELECIONADAS" Style="{StaticResource Muted}"/><TextBlock Text="{Binding AfterSummary}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></Grid>
     <TextBlock Text="TRILHAS" Style="{StaticResource Muted}"/><TextBlock Text="Canais exibidos de 1 a 16. Para incluir bateria, selecione a trilha e desligue o filtro." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
     <DataGrid ItemsSource="{Binding Tracks}" IsReadOnly="False" Height="220" Margin="0,8"><DataGrid.Columns>
      <DataGridTemplateColumn Header="Usar" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Trilha" Binding="{Binding Name}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Instrumento" Binding="{Binding Instrument}" IsReadOnly="True" Width="2*"/><DataGridTextColumn Header="Canal" Binding="{Binding Channels}" IsReadOnly="True" Width="65"/><DataGridTextColumn Header="Notas" Binding="{Binding NoteCount}" IsReadOnly="True" Width="65"/><DataGridTextColumn Header="Faixa" Binding="{Binding Range}" IsReadOnly="True" Width="90"/><DataGridTextColumn Header="Fora C2–C7" Binding="{Binding OutOfRangeCount}" IsReadOnly="True" Width="95"/>
     </DataGrid.Columns></DataGrid>
     <Button Content="Simular Performance" Command="{Binding BenchmarkCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding BenchmarkText}" TextWrapping="Wrap" Margin="0,8"/>
    </StackPanel>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </DockPanel>
</Window>

